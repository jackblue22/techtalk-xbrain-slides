---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleVisuals from "../../components/ArticleVisuals.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const isVietnamese = article.data.lang === "vi";
const translationHref = article.data.translationSlug
  ? `${import.meta.env.BASE_URL}insights/${article.data.translationSlug}/`
  : undefined;
---

<BaseLayout title={`${article.data.title} — Hanoi Local Zone Field Notes`} description={article.data.description} article lang={article.data.lang}>
  <article class="article">
    <header class="article-hero shell">
      <div class="article-meta">
        <p class="eyebrow">{article.data.eyebrow}</p>
        <div>
          <span>{article.data.readingTime}</span>
          <span>{article.data.publishedAt.toLocaleDateString(isVietnamese ? "vi-VN" : "en-GB", { day: "2-digit", month: "short", year: "numeric" })}</span>
        </div>
      </div>
      <h1 class="display-title">{article.data.title}</h1>
      <p class="dek">{article.data.description}</p>
      <div class="tags">{article.data.tags.map((tag: string) => <span>{tag}</span>)}</div>
      {translationHref && (
        <a class="translation-link" href={translationHref} hreflang={isVietnamese ? "en" : "vi"}>
          {isVietnamese ? "Read this article in English →" : "Đọc bài viết bằng tiếng Việt →"}
        </a>
      )}
    </header>

    <ArticleVisuals lang={article.data.lang} />

    <div class="article-grid shell">
      <aside class="toc" aria-label={isVietnamese ? "Mục lục" : "On this page"}>
        <strong>{isVietnamese ? "Trong bài này" : "On this page"}</strong>
        <ol>
          {headings.filter((heading) => heading.depth === 2).map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </aside>
      <div class="prose"><Content /></div>
      <aside class="state-note">
        <span>{isVietnamese ? "Trạng thái hiện tại" : "Current state"}</span>
        <strong>NOT_DEPLOYED</strong>
        <p>{isVietnamese ? "Mọi kết quả AWS trong bài là bằng chứng lịch sử được lưu lại." : "All AWS results in this article are retained historical evidence."}</p>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .article-hero { padding-block: clamp(80px,12vw,150px) 80px; border-bottom: 1px solid var(--line); }
  .article-meta { display: flex; justify-content: space-between; gap: 20px; }
  .article-meta > div { display: flex; gap: 18px; color: var(--ink-faint); font-family: var(--font-mono); font-size: .66rem; text-transform: uppercase; }
  h1 { max-width: 1120px; margin-top: 42px; font-size: clamp(4rem,9.2vw,8.6rem); }
  .dek { max-width: 780px; margin: 34px 0; color: var(--ink-muted); font-family: var(--font-serif); font-size: clamp(1.35rem,2.4vw,2rem); line-height: 1.45; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tags span { border: 1px solid var(--line); border-radius: 999px; padding: 5px 10px; color: var(--ink-muted); font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; }
  .translation-link { display: inline-flex; margin-top: 22px; color: var(--cyan); font-size: .82rem; font-weight: 700; text-decoration: none; }
  .translation-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .article-grid { display: grid; grid-template-columns: 180px minmax(0,var(--reading-width)) 180px; gap: clamp(30px,5vw,72px); justify-content: center; padding-top: 80px; }
  .toc, .state-note { position: sticky; top: 110px; height: fit-content; }
  .toc { max-height: calc(100vh - 140px); overflow-y: auto; padding-right: 8px; }
  .toc strong, .state-note span { color: var(--ink-faint); font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; }
  .toc ol { margin: 16px 0 0; padding: 0; list-style: none; counter-reset: toc; }
  .toc li { counter-increment: toc; }
  .toc a { display: block; padding: 8px 0; color: var(--ink-muted); font-size: .72rem; text-decoration: none; }
  .toc a::before { margin-right: 8px; color: var(--ink-faint); content: counter(toc, decimal-leading-zero); font-family: var(--font-mono); font-size: .58rem; }
  .toc a:hover { color: var(--cyan); }
  .state-note { border-top: 2px solid var(--green); padding-top: 14px; }
  .state-note strong { display: block; margin: 8px 0; color: var(--green); font-size: .86rem; }
  .state-note p { color: var(--ink-faint); font-size: .7rem; }
  .prose { min-width: 0; font-family: var(--font-serif); font-size: 1.16rem; line-height: 1.8; }
  .prose :global(h2) { margin: 3.3em 0 .8em; scroll-margin-top: 110px; font-family: var(--font-serif); font-size: clamp(2.5rem,5vw,4.5rem); font-weight: 600; letter-spacing: -.04em; line-height: 1.02; }
  .prose :global(h3) { margin: 2.4em 0 .6em; font-family: var(--font-sans); font-size: 1.2rem; }
  .prose :global(p), .prose :global(li) { color: #cad3df; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(a) { color: var(--cyan); }
  .prose :global(blockquote) { margin: 2.4em 0; border-left: 3px solid var(--orange); padding: 8px 0 8px 28px; }
  .prose :global(blockquote p) { margin: 0; color: var(--ink); font-size: 1.45rem; line-height: 1.5; }
  .prose :global(table) { display: block; overflow-x: auto; width: 100%; margin: 2em 0; border-collapse: collapse; font-family: var(--font-mono); font-size: .72rem; }
  .prose :global(th), .prose :global(td) { padding: 10px 12px; border: 1px solid var(--line); text-align: right; white-space: nowrap; }
  .prose :global(th:first-child), .prose :global(td:first-child) { text-align: left; }
  .prose :global(th) { background: var(--surface); color: var(--ink); }
  .prose :global(td) { color: var(--ink-muted); }
  .prose :global(code) { border-radius: 3px; padding: .12em .32em; background: var(--surface-strong); color: var(--green); font-family: var(--font-mono); font-size: .82em; }
  .prose :global(hr) { margin: 4em 0; border: 0; border-top: 1px solid var(--line); }
  :global(html[lang="vi"]) h1 { font-size: clamp(3.7rem, 7.2vw, 7rem); }
  @media (max-width: 1080px) { .article-grid { grid-template-columns: minmax(0,var(--reading-width)); } .toc, .state-note { position: static; } .toc { display: none; } .state-note { order: -1; } }
  @media (max-width: 640px) { .article-meta { display: grid; } h1, :global(html[lang="vi"]) h1 { font-size: clamp(3rem,13vw,5rem); } .article-grid { padding-top: 48px; } }
</style>
