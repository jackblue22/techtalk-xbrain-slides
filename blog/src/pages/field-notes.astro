---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

const findings = [
  {
    code: "F-021",
    status: "Resolved",
    title: "The AMI carried a 30 GiB floor.",
    text: "Terraform validation accepted a 12 GiB root volume, but the pinned ECS-optimized AL2023 image came from a 30 GiB snapshot. Provider runtime rules still had the final word.",
    takeaway: "Validate source snapshot size before pinning an EBS root override."
  },
  {
    code: "F-023",
    status: "Resolved",
    title: "A Local Zone name is not an S3 endpoint.",
    text: "Hanoi bootstrap derived an invalid hostname from the zone identifier. The bucket lived in the parent Singapore Region and required the explicit Regional endpoint.",
    takeaway: "Model service scope separately from compute placement."
  },
  {
    code: "F-027",
    status: "Resolved",
    title: "The repair command was rejected at 103 characters.",
    text: "SSM SendCommand limits its Comment field to 100 characters. The request failed safely before any remote mutation, and the wrapper now validates a short deterministic comment locally.",
    takeaway: "Small API constraints belong in preflight, not a recovery surprise."
  },
  {
    code: "F-029",
    status: "Verified",
    title: "The API was never full CRUD.",
    text: "Synthetic create/read/update behavior worked, but the backend has no DELETE endpoint. The portal and documentation were corrected instead of manufacturing a pass.",
    takeaway: "Report what the software implements, not what a demo script hoped for."
  },
  {
    code: "F-039",
    status: "Blocked correctly",
    title: "WARP moved the presenter `/32`.",
    text: "Cloudflare shared egress changed between reviewed addresses. The immutable plan was rejected rather than broadening the security group or silently changing network settings.",
    takeaway: "Operator egress is a security-sensitive deployment input."
  },
  {
    code: "F-047",
    status: "Verified clean",
    title: "Zero resources required an independent audit.",
    text: "The final check covered Terraform state plus EC2, EBS, EIP, S3 versions, snapshots, networking, load balancers, RDS, IAM, and Secrets Manager APIs.",
    takeaway: "A successful destroy is not the same as proven zero residual cost."
  }
];
---

<BaseLayout
  title="Engineering Field Notes — Hanoi Local Zone Lab"
  description="The deployment failures, safety decisions, and operational findings behind the AWS Hanoi Local Zone lab."
>
  <PageHero
    eyebrow="Field notes · Failures preserved"
    title="The useful parts are where it broke."
    marker="Verified / resolved / blocked"
    lede="A polished benchmark hides the bootstrap, networking, API, and teardown constraints that made the result trustworthy. These are the lessons worth reusing."
  />

  <section class="section shell notes">
    {findings.map((finding, index) => (
      <article>
        <div class="note-index"><span>{finding.code}</span><small>{finding.status}</small></div>
        <div class="note-content">
          <h2>{finding.title}</h2>
          <p>{finding.text}</p>
        </div>
        <aside><span>Reusable lesson</span><p>{finding.takeaway}</p></aside>
        <div class="ordinal" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
      </article>
    ))}
  </section>

  <section class="section reading-shell principle">
    <p class="eyebrow">Operating principle</p>
    <blockquote>Do not make the dashboard look successful when the evidence says “not deployed,” “not verified,” or “blocked.”</blockquote>
    <p>That rule drove the provenance model, disabled actions, one-use approvals, failure reporting, and final cleanup audit.</p>
  </section>
</BaseLayout>

<style>
  .notes { padding-top: 0; }
  .notes article { position: relative; display: grid; min-height: 330px; grid-template-columns: 150px minmax(0,1.5fr) minmax(230px,.65fr); gap: clamp(28px,6vw,88px); align-items: start; padding: 52px 0; border-top: 1px solid var(--line); }
  .notes article:last-child { border-bottom: 1px solid var(--line); }
  .note-index { display: grid; gap: 8px; font-family: var(--font-mono); }
  .note-index span { color: var(--cyan); font-size: .75rem; }
  .note-index small { color: var(--green); font-size: .62rem; text-transform: uppercase; }
  .note-content h2 { max-width: 700px; margin: 0; font-family: var(--font-serif); font-size: clamp(2.1rem,4vw,4rem); font-weight: 600; letter-spacing: -.04em; line-height: 1; }
  .note-content p { max-width: 65ch; margin: 24px 0 0; color: var(--ink-muted); }
  aside { border-top: 2px solid var(--orange); padding-top: 14px; }
  aside span { color: var(--ink-faint); font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; }
  aside p { color: var(--ink); font-size: .83rem; }
  .ordinal { position: absolute; z-index: -1; right: 0; bottom: -24px; color: rgba(255,255,255,.022); font-family: var(--font-serif); font-size: 13rem; line-height: 1; }
  .principle { text-align: center; }
  blockquote { margin: 24px 0; font-family: var(--font-serif); font-size: clamp(2.4rem,5vw,4.6rem); font-weight: 600; letter-spacing: -.04em; line-height: 1.05; }
  .principle > p:last-child { color: var(--ink-muted); }
  @media (max-width: 820px) { .notes article { grid-template-columns: 1fr; gap: 24px; } .notes article aside { max-width: 440px; } .ordinal { font-size: 8rem; } }
</style>
