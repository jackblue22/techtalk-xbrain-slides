---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const links = [
  { href: `${base}architecture/`, label: "Architecture" },
  { href: `${base}evidence/`, label: "Evidence" },
  { href: `${base}field-notes/`, label: "Field notes" },
  { href: `${base}run-locally/`, label: "Run locally" },
  { href: `${base}insights/aws-hanoi-local-zone-1200-requests-3-kien-truc/`, label: "Tiếng Việt" }
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={base} aria-label="Hanoi Local Zone Field Notes home">
      <svg aria-hidden="true" viewBox="0 0 32 32" width="32" height="32">
        <rect x="2" y="2" width="28" height="28" rx="6" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M8 10h16v12H8zM8 15h16M14 10v12M20 10v12" fill="none" stroke="currentColor" stroke-width="1.2" />
        <circle cx="20" cy="15" r="2.5" fill="currentColor" />
      </svg>
      <span>
        <strong>Hanoi LZ</strong>
        <small>Field Notes</small>
      </span>
    </a>

    <nav aria-label="Primary navigation">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={path.includes(link.href.replace(base, "/")) ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="github-link" href="https://github.com/jackblue22/techtalk-xbrain-slides" rel="noreferrer">
      <span>Source</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
        <path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
    background: color-mix(in srgb, var(--canvas) 88%, transparent);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: grid;
    min-height: 76px;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: center;
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 11px;
    color: var(--cyan);
    text-decoration: none;
  }

  .brand span {
    display: grid;
    color: var(--ink);
    line-height: 1.15;
  }

  .brand strong {
    font-size: 0.9rem;
    letter-spacing: 0.01em;
  }

  .brand small {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
  }

  nav ul {
    display: flex;
    margin: 0;
    padding: 0;
    gap: 4px;
    list-style: none;
  }

  nav a,
  .github-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    border-radius: 4px;
    padding: 0 12px;
    color: var(--ink-muted);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    background: var(--surface);
    color: var(--ink);
  }

  nav a[aria-current="page"] {
    box-shadow: inset 0 -2px var(--orange);
  }

  .github-link {
    justify-self: end;
    gap: 7px;
  }

  .github-link:hover {
    color: var(--cyan);
  }

  @media (max-width: 860px) {
    .site-header {
      backdrop-filter: none;
    }

    :global(body) {
      padding-bottom: 60px;
    }

    .header-inner {
      min-height: 68px;
      grid-template-columns: 1fr auto;
    }

    nav {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      border-top: 1px solid var(--line);
      background: color-mix(in srgb, var(--canvas) 96%, transparent);
      backdrop-filter: blur(18px);
    }

    nav ul {
      width: min(100%, 560px);
      margin-inline: auto;
      justify-content: space-around;
    }

    nav li {
      flex: 1;
    }

    nav a {
      min-height: 60px;
      justify-content: center;
      padding-inline: 6px;
      font-size: 0.72rem;
    }

    .github-link span {
      position: absolute;
      overflow: hidden;
      width: 1px;
      height: 1px;
      clip: rect(0 0 0 0);
    }
  }
</style>
